# systemd USER unit — installs and runs as sky, no sudo:
#   systemctl --user enable --now ~/beacon/linux/deploy/beacon-client.service
# It only outlives the last login once lingering is on (one sudo line):
#   sudo loginctl enable-linger USER
[Unit]
Description=beacon client — flashes the LED when a Signal trigger arrives
Documentation=file:%h/beacon/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/beacon/linux
ExecStart=/usr/bin/python3 -m beacon_client
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
# No PrivateDevices here: the client needs /dev/gpiochip0 (group gpio).

[Install]
WantedBy=default.target
